# Copy to ".env" and fill in real values. NEVER commit the real .env file.
# All variables are prefixed with CREWAI_.

# --- Runtime ---
CREWAI_ENVIRONMENT=development          # development | staging | production
CREWAI_LOG_LEVEL=INFO

# --- Security (REQUIRED in production) ---
# Generate a strong key:  openssl rand -hex 32
CREWAI_SECRET_KEY=CHANGE_ME

# Bootstrap admin account. Store the HASH, not the plaintext password.
# Generate the hash:  python -m app.security hash 'your-strong-password'
CREWAI_ADMIN_USERNAME=admin
CREWAI_ADMIN_PASSWORD_HASH=

# Optional static API key for the iOS app's service account.
# Generate:  openssl rand -hex 32
CREWAI_SERVICE_API_KEY=

# Access-token lifetime (minutes).
CREWAI_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated allow-list. Include the dashboard origin and any iOS web view
# origin. NEVER use "*" in production.
CREWAI_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Crew execution ---
CREWAI_MAX_CONCURRENT_RUNS=4
CREWAI_RUN_HISTORY_LIMIT=200

# --- LLM provider ---
# Required to run real CrewAI agents. Without it, the gateway runs in simulated
# mode (useful for local development / demos).
CREWAI_OPENAI_API_KEY=
